[Unit]
Description=uWSGI instance to serve takent-backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/repositories/takent-backend
Environment="PATH=/home/ubuntu/.local/share/virtualenvs/takent-backend-libfqfhL/bin"
ExecStart=/home/ubuntu/.local/share/virtualenvs/takent-backend-libfqfhL/bin/uwsgi --ini app.ini

[Install]
WantedBy=multi-user.target
